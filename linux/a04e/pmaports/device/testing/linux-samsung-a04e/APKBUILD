# Reference: https://postmarketos.org/vendorkernel
# Kernel config: arch/arm64/configs/a04e_defconfig
# Toolchain selection is pinned in ../toolchains.json.

pkgname=linux-samsung-a04e
pkgver=4.19.191
pkgrel=1
pkgdesc="Samsung Galaxy A04e downstream kernel (bring-up only)"
arch="aarch64"
_carch="arm64"
_flavor="samsung-a04e"
url="https://github.com/ravindu644/android_kernel_a042f"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	devicepkg-dev
	flex
	gmp-dev
	openssl-dev
	perl
	python3
	rsync
"

_repository="android_kernel_a042f"
_commit="7c1b304f2df8df4c85abe6fe84b8238d7521bd58"
_ksu_commit="56c55b692a00d90c0568a57ef5a8ed0daa23bb9a"
_config="config-$_flavor.$arch"
_clang_url="https://github.com/ravindu644/Android-Kernel-Tutorials/releases/download/toolchains/clang-r383902.tar.gz"
_gnu_url="https://github.com/ravindu644/Android-Kernel-Tutorials/releases/download/toolchains/arm-gnu-toolchain-14.2.rel1-x86_64-aarch64-none-linux-gnu.tar.xz"
source="
	$pkgname-$_commit.tar.gz::https://github.com/ravindu644/$_repository/archive/$_commit.tar.gz
	kernelsu-next-$_ksu_commit.tar.gz::https://github.com/rifsxd/KernelSU-Next/archive/$_ksu_commit.tar.gz
	clang-r383902.tar.gz::$_clang_url
	arm-gnu-toolchain-14.2.rel1-x86_64-aarch64-none-linux-gnu.tar.xz::$_gnu_url
	$_config
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	mkdir -p "$builddir/KernelSU-Next"
	cp -a "$srcdir/KernelSU-Next-$_ksu_commit/." "$builddir/KernelSU-Next/"
	[ -f "$builddir/drivers/kernelsu/Kconfig" ] || die "Pinned KernelSU-Next submodule was not staged correctly"
	export ANDROID_MAJOR_VERSION=r
	. downstreamkernel_prepare
}

build() {
	unset LDFLAGS

	local clang
	local cross_gcc
	clang="$(find "$srcdir" -path '*/bin/clang' -print -quit)"
	cross_gcc="$(find "$srcdir" -name 'aarch64-none-linux-gnu-gcc' -print -quit)"
	[ -x "$clang" ] || die "Pinned clang-r383902 compiler was not found"
	[ -x "$cross_gcc" ] || die "Pinned AArch64 GNU cross compiler was not found"

	export ANDROID_MAJOR_VERSION=r
	make O="$_outdir" ARCH="$_carch" CC="$clang" \
		CROSS_COMPILE="${cross_gcc%gcc}" CLANG_TRIPLE=aarch64-linux-gnu- \
		KCFLAGS="-w" CONFIG_SECTION_MISMATCH_WARN_ONLY=y a04e_defconfig

	"$builddir/scripts/kconfig/merge_config.sh" -m -O "$_outdir" \
		"$_outdir/.config" "$srcdir/$_config"
	make O="$_outdir" ARCH="$_carch" CC="$clang" \
		CROSS_COMPILE="${cross_gcc%gcc}" CLANG_TRIPLE=aarch64-linux-gnu- \
		KCFLAGS="-w" CONFIG_SECTION_MISMATCH_WARN_ONLY=y olddefconfig

	# Build kernel and both A04e board-tree outputs.
	make O="$_outdir" ARCH="$_carch" CC="$clang" \
		CROSS_COMPILE="${cross_gcc%gcc}" CLANG_TRIPLE=aarch64-linux-gnu- \
		KCFLAGS="-w" CONFIG_SECTION_MISMATCH_WARN_ONLY=y \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" -j"${JOBS:-2}"
	make O="$_outdir" ARCH="$_carch" CC="$clang" \
		CROSS_COMPILE="${cross_gcc%gcc}" CLANG_TRIPLE=aarch64-linux-gnu- \
		KCFLAGS="-w" CONFIG_SECTION_MISMATCH_WARN_ONLY=y dtbs

	[ -s "$_outdir/arch/arm64/boot/Image.gz" ] || die "Kernel Image.gz missing"
	[ -s "$_outdir/arch/arm64/boot/dts/mediatek/mt6765.dtb" ] || die "MT6765 base DTB missing"
	[ -s "$_outdir/arch/arm64/boot/dts/mediatek/mt6765_a04e_eur_open_00.dtb" ] || die "A04e DT overlay missing"
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	local dtb_dir="$_outdir/arch/arm64/boot/dts/mediatek"
	install -Dm644 "$builddir/$dtb_dir/mt6765.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6765.dtb"
	install -Dm644 "$builddir/$dtb_dir/mt6765_a04e_eur_open_00.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6765_a04e_eur_open_00.dtbo"
}

