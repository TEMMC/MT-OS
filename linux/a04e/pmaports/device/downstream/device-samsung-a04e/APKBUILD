# Reference: https://postmarketos.org/devicepkg
pkgname=device-samsung-a04e
pkgdesc="Samsung Galaxy A04e (SM-A042F) bring-up device package"
pkgver=0.2
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-samsung-a04e
	postmarketos-base
	make-dynpart-mappings
	mkbootimg
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

