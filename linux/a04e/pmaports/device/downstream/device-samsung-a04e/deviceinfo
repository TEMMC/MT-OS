# https://postmarketos.org/deviceinfo
# Samsung Galaxy A04e SM-A042F (MT6765 / HS04).
deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy A04e"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-a04e"
deviceinfo_year="2022"
deviceinfo_arch="aarch64"
deviceinfo_chassis="handset"
deviceinfo_external_storage="true"
deviceinfo_screen_width="720"
deviceinfo_screen_height="1600"
deviceinfo_root_filesystem="ext4"

# Stock boot partition is an Android boot image (header v2, 2048-byte pages).
# Samsung Odin/Heimdall boot-image mode matches this boot-image format.
# Heimdall compatibility and the full restore path must be validated before
# any partition is flashed; this setting only enables correct image packaging.
deviceinfo_flash_method="heimdall-bootimg"
deviceinfo_flash_heimdall_partition_kernel="BOOT"
deviceinfo_flash_heimdall_partition_rootfs="USERDATA"
deviceinfo_generate_bootimg="true"
deviceinfo_header_version="2"
deviceinfo_flash_pagesize="2048"
deviceinfo_flash_offset_base="0x40078000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x11a88000"
deviceinfo_flash_offset_tags="0x07808000"
deviceinfo_flash_offset_dtb="0x07808000"

# Use the merged MT6765 + A04e/HS04 device tree. The kernel APKBUILD applies
# the Samsung /plugin/ overlay so the board's panel and Jadard SPI nodes exist
# in the final boot-image DTB.
deviceinfo_dtb="mediatek/mt6765_a04e_eur_open_00"
deviceinfo_append_dtb="false"
deviceinfo_bootimg_qcdt="false"
deviceinfo_bootimg_dtb_second="false"

# Legacy MTK framebuffer/LCM is present, but MT6765 DRM/KMS is not ported.
# Keep this false until a DRM/KMS driver and working compositor are verified.
deviceinfo_drm="false"
