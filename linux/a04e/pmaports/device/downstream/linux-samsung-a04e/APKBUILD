# Reference: https://postmarketos.org/vendorkernel
# The compressed Image.gz is reused from the verified CI kernel build.
# The A04e board DTS is a plugin overlay. Merge it into the MT6765 base DTB
# so the boot image carries the board-specific display, GPIO and SPI touch nodes.

pkgname=linux-samsung-a04e
pkgver=4.19.191
pkgrel=3
pkgdesc="Samsung Galaxy A04e downstream kernel (prebuilt kernel bring-up)"
arch="aarch64"
_carch="arm64"
_flavor="samsung-a04e"
url="https://github.com/ravindu644/android_kernel_a042f"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	clang
	lld
	llvm
	bc
	bison
	devicepkg-dev
	dtc
	flex
	gmp-dev
	openssl-dev
	perl
	python3
	rsync
"

_repository="android_kernel_a042f"
_commit="7c1b304f2df8df4c85abe6fe84b8238d7521bd58"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/ravindu644/$_repository/archive/$_commit.tar.gz
	$_config
	Image.gz
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare

	# The vendor archive has CRLF endings and patch-style '+' prefixes in
	# several Kconfig files. Normalize their bytes before any Kconfig parser runs.
	# Use Python byte processing so this is independent of sed/BusyBox semantics.
	python3 - "$builddir" <<'PY'
import os
import sys
root = sys.argv[1]
changed = []
for base, dirs, files in os.walk(root):
    for name in files:
        if name != "Kconfig":
            continue
        path = os.path.join(base, name)
        with open(path, "rb") as stream:
            data = stream.read()
        normalized = data.replace(b"\r\n", b"\n").replace(b"\r", b"\n")
        normalized = b"\n".join(line[1:] if line.startswith(b"+") else line
                                  for line in normalized.split(b"\n"))
        if normalized != data:
            with open(path, "wb") as stream:
                stream.write(normalized)
            changed.append(os.path.relpath(path, root))
print("Normalized Kconfig files:", len(changed))
for path in changed:
    print("  ", path)
# Fail early if patch markers or CR bytes remain in any Kconfig file.
for base, dirs, files in os.walk(root):
    for name in files:
        if name == "Kconfig":
            path = os.path.join(base, name)
            data = open(path, "rb").read()
            if b"\r" in data or any(line.startswith(b"+") for line in data.split(b"\n")):
                raise SystemExit("Kconfig normalization failed: " + path)
PY


	# downstreamkernel_prepare runs oldconfig immediately. The source archive
	# omits KernelSU-Next, so remove its dangling Kconfig reference first.
	awk 'index($0, "drivers/kernelsu/Kconfig") == 0' "$builddir/drivers/Kconfig" > "$builddir/drivers/Kconfig.tmp"
	mv "$builddir/drivers/Kconfig.tmp" "$builddir/drivers/Kconfig"
	if grep -Fq 'drivers/kernelsu/Kconfig' "$builddir/drivers/Kconfig"; then
		die "KernelSU Kconfig reference remains in the source archive"
	fi

	# Generate ARM64 generic UAPI asm symlinks before downstreamkernel_prepare.
	# The host SELinux genheaders utility includes linux/capability.h, which
	# requires the generated arch/arm64/.../asm/types.h header.
	mkdir -p "$_outdir"
	make O="$_outdir" ARCH="$_carch" LLVM=1 LLVM_IAS=1 uapi-asm-generic
	[ -s "$_outdir/arch/arm64/include/generated/uapi/asm/types.h" ] ||
		die "ARM64 generated UAPI asm/types.h is missing"

	# downstreamkernel_prepare invokes oldconfig, which builds host-side
	# SELinux tools before Kbuild has completed its normal header preparation.
	# Supply all ARM64 UAPI include roots explicitly so genheaders can resolve
	# <asm/types.h> during that early host-tool build.
	install -Dm644 "$srcdir/$_config" "$builddir/$_outdir/.config"
	export HOSTCFLAGS="${HOSTCFLAGS:-} -I$builddir/arch/arm64/include/uapi -I$builddir/$_outdir/arch/arm64/include/generated/uapi -I$builddir/include/uapi -I$builddir/$_outdir/include/generated/uapi"

	# Use postmarketOS' installed LLVM tools consistently for preparation,
	# DTB generation and kernel metadata. Preserve the vendor compiler header.
	export LLVM=1 LLVM_IAS=1
	REPLACE_GCCH=0 . downstreamkernel_prepare
}
build() {
	unset LDFLAGS
	export ARCH="$_carch"
	export LLVM=1 LLVM_IAS=1

	make O="$_outdir" ARCH="$_carch" a04e_defconfig
	"$builddir/scripts/kconfig/merge_config.sh" -m -O "$_outdir" \
		"$_outdir/.config" "$srcdir/$_config"
	make O="$_outdir" ARCH="$_carch" olddefconfig

	# The prebuilt kernel was built from the live A04e defconfig. Fail closed
	# if a future source/config change drops the vendor display or Jadard path.
	for required in \
		CONFIG_MTK_LCM=y \
		CONFIG_MTK_FB=y \
		CONFIG_TOUCHSCREEN_JADARD_MODULE=y \
		CONFIG_TOUCHSCREEN_JADARD_IC_JD9365T=y \
		CONFIG_TOUCHSCREEN_JADARD_COMMON=y \
		CONFIG_TOUCHSCREEN_JADARD_CHIPSET_M04=y \
		CONFIG_DEVTMPFS=y \
		CONFIG_DEVTMPFS_MOUNT=y \
		CONFIG_BT_RFCOMM=y \
		CONFIG_BT_BNEP=y \
		CONFIG_BT_HIDP=y \
		CONFIG_MTK_COMBO=y \
		CONFIG_MTK_COMBO_CHIP_CONSYS_6765=y \
		CONFIG_MTK_COMBO_COMM=y \
		CONFIG_MTK_COMBO_BT_HCI=y \
		CONFIG_MTK_COMBO_WIFI=y \
		CONFIG_POWER_SUPPLY=y \
		CONFIG_BATTERY_MT6357=y \
		CONFIG_CHARGER_TYPE_MT6357=y \
		CONFIG_MTK_CHARGER=y \
		CONFIG_MTK_KERNEL_POWER_OFF_CHARGING=y \
		CONFIG_MTK_SENSOR_SUPPORT=y \
		CONFIG_MTK_THERMAL=y \
		CONFIG_MMC=y \
		CONFIG_MTK_EMMC_SUPPORT=y \
		CONFIG_USB_MTK_HDRC=y \
		CONFIG_USB_MTK_OTG=y \
		CONFIG_MTK_GPU_SUPPORT=y \
		CONFIG_MTK_CCCI_DEVICES=y \
		CONFIG_MTK_ECCCI_DRIVER=y \
		CONFIG_MTK_ECCCI_CLDMA=y; do
		grep -Fqx "$required" "$_outdir/.config" || die "Required A04e display/touch config missing: $required"
	done
	grep -Fq 'lcd_jd9365t_txd_ctc_mipi_hdp_video' "$_outdir/.config" || die "A04e panel candidate list missing JD9365T CTC"
	grep -Fq 'lcd_gc7202_ls_hsd_mipi_hdp_video' "$_outdir/.config" || die "A04e panel candidate list missing GC7202"
	grep -Fq 'lcd_nl9911c_hlt_hkc_mipi_hdp_video' "$_outdir/.config" || die "A04e panel candidate list missing NL9911C"

	# Generate only the DTB outputs. Do not compile the kernel again.
	# Export symbol labels in the base DTB so the /plugin/ A04e overlay can
	# resolve its &chosen, &odm, &spi1, &touch and peripheral references.
	make O="$_outdir" ARCH="$_carch" DTC_FLAGS="-@" dtbs

	[ -s "$srcdir/Image.gz" ] || die "Verified prebuilt Image.gz is missing"
	[ -s "$_outdir/arch/arm64/boot/dts/mediatek/mt6765.dtb" ] || die "MT6765 base DTB missing"
	[ -s "$_outdir/arch/arm64/boot/dts/mediatek/mt6765_a04e_eur_open_00.dtb" ] || die "A04e device-tree overlay missing"

	# Samsung marks the A04e DTS with /plugin/. It must be applied to the MT6765
	# base tree; placing the overlay blob in boot.img as if it were a full DTB
	# would leave the HS04 panel and Jadard SPI touchscreen nodes unapplied.
	fdtoverlay -i "$_outdir/arch/arm64/boot/dts/mediatek/mt6765.dtb" \
		-o "$_outdir/arch/arm64/boot/dts/mediatek/mt6765_a04e_eur_open_00-merged.dtb" \
		"$_outdir/arch/arm64/boot/dts/mediatek/mt6765_a04e_eur_open_00.dtb"
	[ -s "$_outdir/arch/arm64/boot/dts/mediatek/mt6765_a04e_eur_open_00-merged.dtb" ] || die "Merged A04e device tree missing"
	# Verify the merged tree really contains both the board panel node and
	# the Jadard SPI controller binding expected by the handset diagnostics.
	dtc -I dtb -O dts -o "$_outdir/a04e-merged-check.dts" \
		"$_outdir/arch/arm64/boot/dts/mediatek/mt6765_a04e_eur_open_00-merged.dtb"
	grep -Fq 'mediatek,lcm-panel' "$_outdir/a04e-merged-check.dts" || die "A04e panel node missing from merged DTB"
	grep -Fq 'jadard,jdcommon' "$_outdir/a04e-merged-check.dts" || die "Jadard touchscreen node missing from merged DTB"
}

package() {
	# Keep the exact compressed kernel binary from the successful kernel run.
	install -Dm644 "$srcdir/Image.gz" "$pkgdir/boot/vmlinuz-$_flavor"

	# Kernel release metadata is needed by postmarketOS boot tooling.
	make -s O="$_outdir" ARCH="$_carch" kernelrelease \
		> "$pkgdir/kernel.release.tmp"
	install -Dm644 "$pkgdir/kernel.release.tmp" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
	rm -f "$pkgdir/kernel.release.tmp"

	local dtb_dir="$_outdir/arch/arm64/boot/dts/mediatek"
	install -Dm644 "$dtb_dir/mt6765.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6765.dtb"
	install -Dm644 "$dtb_dir/mt6765_a04e_eur_open_00-merged.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6765_a04e_eur_open_00.dtb"
	install -Dm644 "$dtb_dir/mt6765_a04e_eur_open_00.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6765_a04e_eur_open_00.dtbo"
}

