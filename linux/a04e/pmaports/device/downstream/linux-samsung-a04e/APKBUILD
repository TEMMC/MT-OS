# Reference: https://postmarketos.org/vendorkernel
# The compressed Image.gz is reused from the verified CI kernel build.
# Only the MT6765 base DTB and A04e board overlay are generated here.

pkgname=linux-samsung-a04e
pkgver=4.19.191
pkgrel=3
pkgdesc="Samsung Galaxy A04e downstream kernel (prebuilt kernel bring-up)"
arch="aarch64"
_carch="arm64"
_flavor="samsung-a04e"
url="https://github.com/ravindu644/android_kernel_a042f"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	clang
	lld
	llvm
	bc
	bison
	devicepkg-dev
	dtc
	flex
	gmp-dev
	openssl-dev
	perl
	python3
	rsync
"

_repository="android_kernel_a042f"
_commit="7c1b304f2df8df4c85abe6fe84b8238d7521bd58"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/ravindu644/$_repository/archive/$_commit.tar.gz
	$_config
	Image.gz
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare

	# The vendor archive contains CRLF and patch-style leading '+' markers in
	# several Kconfig files. Kconfig's parser rejects those bytes during
	# downstreamkernel_prepare's immediate oldconfig run. Normalize only Kconfig
	# metadata in this temporary build tree; leave driver sources untouched.
	find "$builddir" -type f -name Kconfig -exec sed -i -e 's/\r$//' -e 's/^+//' {} +


	# downstreamkernel_prepare runs oldconfig immediately. The source archive
	# omits KernelSU-Next, so remove its dangling Kconfig reference first.
	awk 'index($0, "drivers/kernelsu/Kconfig") == 0' "$builddir/drivers/Kconfig" > "$builddir/drivers/Kconfig.tmp"
	mv "$builddir/drivers/Kconfig.tmp" "$builddir/drivers/Kconfig"
	if grep -Fq 'drivers/kernelsu/Kconfig' "$builddir/drivers/Kconfig"; then
		die "KernelSU Kconfig reference remains in the source archive"
	fi

	# This vendor Makefile hard-codes an in-tree Android Clang path that is
	# absent from the source archive. Use postmarketOS' installed LLVM tools
	# consistently for Kconfig preparation, DTB generation and kernel metadata.
	export LLVM=1
	. downstreamkernel_prepare
}
build() {
	unset LDFLAGS
	export ARCH="$_carch"

	make O="$_outdir" ARCH="$_carch" a04e_defconfig
	"$builddir/scripts/kconfig/merge_config.sh" -m -O "$_outdir" \
		"$_outdir/.config" "$srcdir/$_config"
	make O="$_outdir" ARCH="$_carch" olddefconfig

	# Generate only the DTB outputs. Do not compile the kernel again.
	make O="$_outdir" ARCH="$_carch" dtbs

	[ -s "$srcdir/Image.gz" ] || die "Verified prebuilt Image.gz is missing"
	[ -s "$_outdir/arch/arm64/boot/dts/mediatek/mt6765.dtb" ] || die "MT6765 base DTB missing"
	[ -s "$_outdir/arch/arm64/boot/dts/mediatek/mt6765_a04e_eur_open_00.dtb" ] || die "A04e board DT overlay missing"
}

package() {
	# Keep the exact compressed kernel binary from the successful kernel run.
	install -Dm644 "$srcdir/Image.gz" "$pkgdir/boot/vmlinuz-$_flavor"

	# Kernel release metadata is needed by postmarketOS boot tooling.
	make -s O="$_outdir" ARCH="$_carch" kernelrelease \
		> "$pkgdir/kernel.release.tmp"
	install -Dm644 "$pkgdir/kernel.release.tmp" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
	rm -f "$pkgdir/kernel.release.tmp"

	local dtb_dir="$_outdir/arch/arm64/boot/dts/mediatek"
	install -Dm644 "$dtb_dir/mt6765.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6765.dtb"
	install -Dm644 "$dtb_dir/mt6765_a04e_eur_open_00.dtb" \
		"$pkgdir/boot/dtbs/mediatek/mt6765_a04e_eur_open_00.dtbo"
}

