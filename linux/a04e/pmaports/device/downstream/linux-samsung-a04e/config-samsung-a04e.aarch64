# A04e postmarketOS bring-up additions layered on the exact stock defconfig.
# Only options backed by the pinned MT6765/HS04 source and observed hardware
# are enabled here. The vendor display is legacy mtkfb/LCM, not DRM/KMS.

# Linux userspace device discovery (required by udev/OpenRC initramfs).
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Storage/filesystems needed by the diagnostic initramfs and rootfs.
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y

# Preserve the stock MT6765 PMIC battery and charger drivers for the handset.
# These are real Kconfig symbols in this kernel tree (not CONFIG_MTK_BATTERY).
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_MT6357=y
CONFIG_CHARGER_TYPE_MT6357=y
CONFIG_MTK_CHARGER=y
CONFIG_MTK_KERNEL_POWER_OFF_CHARGING=y

# MT6765 CONSYS_6765 / MT6631 combo connectivity stack.
# The pinned 4.19 vendor source builds WMT, Gen4M WLAN, GPS and FM in-tree.
CONFIG_MTK_COMBO=y
CONFIG_MTK_COMBO_CHIP_CONSYS_6765=y
CONFIG_MTK_COMBO_COMM=y
CONFIG_MTK_COMBO_BT=y
CONFIG_MTK_COMBO_WIFI=y
CONFIG_MTK_COMBO_GPS=y
CONFIG_MTK_GPS_SUPPORT=y
CONFIG_MTK_FMRADIO=y
CONFIG_MTK_BTIF=y

# BlueZ profiles are enabled for a future verified HCI transport. The
# included vendor Bluetooth component is WMT/BTIF, not yet a proven BlueZ HCI.
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y

# Keep the A04e legacy display and active Jadard path enabled.
# These vendor drivers do not establish a working DRM/KMS compositor or
# identify the physical LCD panel variant.
CONFIG_MTK_LCM=y
CONFIG_MTK_FB=y
CONFIG_TOUCHSCREEN_MTK=y
CONFIG_TOUCHSCREEN_JADARD_MODULE=y
CONFIG_TOUCHSCREEN_JADARD_IC_JD9365T=y
CONFIG_TOUCHSCREEN_JADARD_COMMON=y
CONFIG_TOUCHSCREEN_JADARD_CHIPSET_M04=y

