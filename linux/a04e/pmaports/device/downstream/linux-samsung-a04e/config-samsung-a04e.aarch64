# Minimal initramfs/storage requirements layered on the exact stock defconfig.
# Display acceleration is deliberately NOT enabled here: MT6765 DRM/KMS
# support has not been established for this downstream kernel.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
